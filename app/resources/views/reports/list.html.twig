{% extends 'reports/layout.html.twig' %}

{% block main %}
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h4>Reports</h4>
            <table id="data-table" class="table table-condensed table-striped">
                <thead>
                <tr>
                    <th scope="col">
                        <label class="control control--checkbox">
                            <input type="checkbox" class="js-check-all" />
                            <div class="control__indicator"></div>
                        </label>
                    </th>
                    <th scope="col">Order #</th>
                    <th scope="col">Received On</th>
                    <th scope="col">Received by</th>
                    <th scope="col">Before Tax</th>
                    <th scope="col">After Tax</th>
                    <th>Paid</th>
                    <th>Due</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for invoice in invoices %}
                    <tr scope="row">
                        <th scope="row">
                            <label class="control control--checkbox">
                                <input type="checkbox" />
                                <div class="control__indicator"></div>
                            </label>
                        </th>
                        <td>{{ invoice.getId() }}</td>
                        <td>{{ invoice.getDateReceived() | date("d/m/Y") }}</td>
                        <td>{{ invoice.getReceiverName() }}</td>
                        <td>{{ invoice.getTotalBeforeTax() | money_format }}</td>
                        <td>{{ invoice.getTotalAfterTax() | money_format }}</td>
                        <td>{{ invoice.getAmountPaid() | money_format }}</td>
                        <td>{{ invoice.getTotalAmountDue() | money_format }}</td>
                        <td><a href="/reports/print/{{ user.getId() }}/{{ invoice.getId() }}">Print Invoice</a> </td>
                    </tr>
                    <tr class="spacer">
                        <td colspan="100"></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}